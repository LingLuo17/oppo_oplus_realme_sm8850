# ==================== 自定义提交配置 ====================
# 本文件用于为 SUSFS（cctv18/susfs4oki）锁定自定义提交
#
# 使用说明:
#   1. 将 custom 设为 true 启用自定义提交功能
#   2. 在对应分支配置项后填入想要使用的 40 位 commit hash
#   3. 留空表示使用该分支的最新提交
#
# 示例:
#   oki-android16-6.12=0123456789abcdef0123456789abcdef01234567
#
# ================================================================

# 是否启用自定义提交 (true/false)
custom=false

# ==================== SUSFS 各分支的 commit hash ====================
# 仅当 custom=true 时生效
oki-android14-6.1=
oki-android15-6.6=
oki-android16-6.12=
